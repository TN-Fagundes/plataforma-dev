# Copie para .env (não versionado) e ajuste. Portas: ver rede.md.

# --- Gitea ---
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_ROOT_URL=http://localhost:3001/   # etapa (b): http://<host>:3001/
GITEA_DOMAIN=localhost                  # etapa (b): <host>
UID=1000
GID=1000

# --- SonarQube ---
SONAR_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=sonar

# --- Observabilidade (dev) ---
GRAFANA_PORT=3002
GRAFANA_PASSWORD=admin
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@plataforma.local
GF_SMTP_FROM_NAME=Grafana Plataforma
GF_SMTP_SKIP_VERIFY=true
