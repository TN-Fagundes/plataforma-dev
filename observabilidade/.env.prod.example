# Observabilidade de PRODUÇÃO (docker-compose.prod.yml). No servidor, copie para
# .env.prod (não versionado) e preencha. Ver PRODUCAO.md.

# Obrigatória: o compose recusa subir sem ela.
GRAFANA_PASSWORD=trocar-em-prod
GRAFANA_PORT=3001

# SMTP dos alertas. Pode ser o mesmo servidor e as mesmas credenciais das
# aplicações (no auditoria-2.0: MAIL_HOST:MAIL_PORT, MAIL_USERNAME, ...).
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.empresa.local:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@empresa.local
GF_SMTP_FROM_NAME=Grafana Producao
GF_SMTP_SKIP_VERIFY=true

# Destinatário de TODOS os alertas da instância (contact point email-alertas).
GF_ALERTING_EMAIL_TO=equipe@empresa.local
